APP_NAME="GhostFix AI"
ENVIRONMENT=development
LOG_LEVEL=INFO

# Required only when creating a Nebius LLM client.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# Set the exact model ID available in your Nebius Token Factory account.
NEBIUS_MODEL=

SANDBOX_IMAGE=ghostfix-pytest-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=120

PATCH_MAX_FILES=2
PATCH_MAX_CHANGED_LINES=100
PATCH_MAX_DIFF_BYTES=12000
